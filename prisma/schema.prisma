generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  admin        Admin?
  donor        Donor?
  sessions     UserSession[]

  @@index([role])
  @@map("users")
}

model Admin {
  id                     String              @id @default(cuid())
  userId                 String              @unique @map("user_id")
  displayName            String              @map("display_name")
  /// Marks the public demo admin account. Used to scope what the UI explains about this
  /// account and to keep it out of any future admin-management features without special-casing
  /// its email. Does not grant or remove any permission by itself.
  isDemo                 Boolean             @default(false) @map("is_demo")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedWithdrawals    WithdrawalRequest[] @relation("WithdrawalReviewer")
  requestedOrganRequests OrganRequest[]      @relation("OrganRequestRequester")
  reviewedOrganRequests  OrganRequest[]      @relation("OrganRequestReviewer")

  @@map("admins")
}

model Donor {
  id                 String              @id @default(cuid())
  userId             String              @unique @map("user_id")
  /// Human-facing Donor ID (legacy "Username", e.g. DN4K7Q2M)
  donorCode          String              @unique @map("donor_code")
  firstName          String              @map("first_name")
  lastName           String              @map("last_name")
  gender             Gender
  dateOfBirth        DateTime            @map("date_of_birth") @db.Date
  phone              String
  address            String
  city               String
  state              String
  personalDoctor     String?             @map("personal_doctor")
  /// Registered/preferred hospital (legacy free-text donor.Hospital -> FK)
  hospitalId         String?             @map("hospital_id")
  medicalConditions  String?             @map("medical_conditions")
  /// Nullable: not collected by the original registration form. New analytics dimension only
  /// (donor/organ compatibility matching is explicitly out of scope for this phase).
  bloodType          BloodType?          @map("blood_type")
  status             DonorStatus         @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  hospital           Hospital?           @relation(fields: [hospitalId], references: [id])
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  nextOfKin          NextOfKin?
  organs             Organ[]
  withdrawalRequests WithdrawalRequest[]

  @@index([hospitalId])
  @@index([status])
  @@index([city])
  @@index([lastName, firstName])
  @@index([bloodType])
  @@map("donors")
}

model NextOfKin {
  id           String   @id @default(cuid())
  donorId      String   @unique @map("donor_id")
  name         String
  phone        String
  relationship String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  donor        Donor    @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@map("next_of_kin")
}

model Hospital {
  id            String         @id @default(cuid())
  name          String
  city          String
  state         String?
  address       String
  phone         String
  email         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  donors        Donor[]
  organs        Organ[]
  organRequests OrganRequest[]

  @@unique([name, city])
  @@index([city])
  @@map("hospitals")
}

model Organ {
  id              String         @id @default(cuid())
  donorId         String         @map("donor_id")
  hospitalId      String         @map("hospital_id")
  organType       OrganType      @map("organ_type")
  /// Free-text label, required when organType = OTHER (e.g. tissue name)
  otherOrganName  String?        @map("other_organ_name")
  status          OrganStatus    @default(PENDING)
  procurementDate DateTime       @map("procurement_date") @db.Date
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  donor           Donor          @relation(fields: [donorId], references: [id], onDelete: Cascade)
  hospital        Hospital       @relation(fields: [hospitalId], references: [id])
  requests        OrganRequest[]

  @@index([donorId])
  @@index([hospitalId])
  @@index([organType, status])
  @@index([status])
  @@map("organs")
}

model WithdrawalRequest {
  id           String           @id @default(cuid())
  donorId      String           @map("donor_id")
  reason       String
  status       WithdrawalStatus @default(PENDING)
  adminNote    String?          @map("admin_note")
  reviewedById String?          @map("reviewed_by_id")
  reviewedAt   DateTime?        @map("reviewed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  donor        Donor            @relation(fields: [donorId], references: [id], onDelete: Cascade)
  reviewedBy   Admin?           @relation("WithdrawalReviewer", fields: [reviewedById], references: [id])

  @@index([donorId, status])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

/// A hospital's request to receive a specific AVAILABLE organ. There is no hospital login in
/// this system (see Role enum), so requests are entered by an admin on the requesting
/// hospital's behalf — the same model already used for every other hospital-facing record
/// (Organ, Hospital itself). Explicitly NOT a recipient/compatibility/matching model: it
/// references one concrete Organ row, never a patient, and carries no medical criteria.
///
/// PENDING   — submitted, awaiting admin decision.
/// APPROVED  — admin approved; the organ is transactionally marked UNAVAILABLE (allocated).
/// DECLINED  — admin declined; the organ's availability is left untouched.
/// CANCELLED — withdrawn before a decision (also leaves the organ untouched).
model OrganRequest {
  id            String             @id @default(cuid())
  organId       String             @map("organ_id")
  hospitalId    String             @map("hospital_id")
  status        OrganRequestStatus @default(PENDING)
  /// Free-text operational context from the requesting hospital (e.g. urgency, ward).
  notes         String?
  /// Required when status = DECLINED; null otherwise.
  declineReason String?            @map("decline_reason")
  requestedById String?            @map("requested_by_id")
  reviewedById  String?            @map("reviewed_by_id")
  reviewedAt    DateTime?          @map("reviewed_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  organ         Organ              @relation(fields: [organId], references: [id], onDelete: Cascade)
  hospital      Hospital           @relation(fields: [hospitalId], references: [id])
  requestedBy   Admin?             @relation("OrganRequestRequester", fields: [requestedById], references: [id])
  reviewedBy    Admin?             @relation("OrganRequestReviewer", fields: [reviewedById], references: [id])

  @@index([organId, status])
  @@index([hospitalId, status])
  @@index([status, createdAt])
  @@map("organ_requests")
}

enum OrganRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

enum Role {
  DONOR
  ADMIN
  /// Full admin capabilities plus system recovery. Never created through the public API;
  /// see server/scripts/create-super-admin.ts. There is no public sign-up or promotion path.
  SUPER_ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// PENDING    — registered but not yet verified by an administrator (mirrors Organ's own
///              PENDING -> AVAILABLE verification step). Not currently set by the public
///              registration flow (new donors still default to ACTIVE, unchanged); exists so
///              a donor-level verification step can be introduced later without another
///              migration, and so "pending donors" is a real, queryable analytics dimension
///              rather than an invented one.
/// ACTIVE     — registered and in good standing.
/// WITHDRAWN  — withdrawal request approved; see WithdrawalRequest.
enum DonorStatus {
  PENDING
  ACTIVE
  WITHDRAWN
}

enum BloodType {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum OrganType {
  KIDNEY
  LIVER
  HEART
  LUNG
  PANCREAS
  CORNEA
  OTHER
}

/// PENDING     — submitted by a donor, awaiting admin verification (never public)
/// AVAILABLE   — verified/procured and available at the hospital
/// UNAVAILABLE — no longer available (used, expired, or donor withdrew)
enum OrganStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RecoveryStatus {
  SUCCEEDED
  FAILED
}

/// Audit trail for demo-database recovery operations (System Recovery, Super Admin only).
/// Never stores credentials, connection strings, backup paths, or raw error output that could
/// contain any of those; see server/src/services/recovery.service.ts for what is recorded.
model RecoveryLog {
  id             String         @id @default(cuid())
  initiatedBy    String         @map("initiated_by")
  initiatorEmail String         @map("initiator_email")
  status         RecoveryStatus
  /// Short, operator-facing summary only (e.g. "Restored from snapshot" or "pg_restore exited
  /// with a non-zero status"). Never raw command output, stack traces, or connection details.
  message        String?
  startedAt      DateTime       @default(now()) @map("started_at")
  finishedAt     DateTime?      @map("finished_at")

  @@index([startedAt])
  @@map("recovery_logs")
}

enum WorkflowEntityType {
  DONOR
  ORGAN
  WITHDRAWAL_REQUEST
  ORGAN_REQUEST
}

enum WorkflowEventType {
  CREATED
  STATUS_CHANGED
}

/// Lightweight workflow history for the status-bearing entities (Donor, Organ,
/// WithdrawalRequest, OrganRequest). Exists to make processing-time, pending-age and bottleneck analytics
/// (see server/src/services/analytics.service.ts) derivable from real recorded transitions
/// instead of only the current `updatedAt`, which cannot show *when* an intermediate state was
/// entered if the entity has changed status more than once. Deliberately NOT a general-purpose
/// event-sourcing log: it only ever records a status actually changing (or a row being created),
/// written by the same services that already perform those transitions, never a new/parallel
/// write path. `actorId` is the acting Admin's id (matching WithdrawalRequest.reviewedById)
/// when an admin performed the transition, null for a donor's own self-service action (e.g.
/// submitting their own withdrawal request or registering their own organ).
model WorkflowEvent {
  id         String             @id @default(cuid())
  entityType WorkflowEntityType @map("entity_type")
  entityId   String             @map("entity_id")
  eventType  WorkflowEventType  @map("event_type")
  fromStatus String?            @map("from_status")
  toStatus   String?            @map("to_status")
  actorId    String?            @map("actor_id")
  createdAt  DateTime           @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([entityType, eventType, createdAt])
  @@index([createdAt])
  @@map("workflow_events")
}

/// A lightweight, public, no-account "intent to donate" record — deliberately NOT a Donor.
/// Collects only what's needed to issue a pledge certificate: no medical history, no next-of-kin,
/// no government ID, no detailed address. Never automatically creates a User/Donor account, and
/// has no FK to either — a pledge and a full donor registration are two separate concepts by
/// design. `referenceId` is the human-facing id shown on the certificate (format: PLG-XXXXXXXX).
model Pledge {
  id              String    @id @default(cuid())
  referenceId     String    @unique @map("reference_id")
  fullName        String    @map("full_name")
  email           String
  city            String
  organPreference OrganType @map("organ_preference")
  consentedAt     DateTime  @map("consented_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@index([createdAt])
  @@map("pledges")
}

// ---------------------------------------------------------------------------
// Security / access-control layer (RBAC + ownership + ABAC). See
// server/src/security/policyEngine.ts for the actual enforcement logic - every row here is a
// read audit trail or a display-only reference copy of the policy matrix, never the source of
// a live decision. The AI investigation layer is secured by the same policy engine, through
// agent/securityTools.ts and agent/securityGateway.ts, not a separate mechanism.
// ---------------------------------------------------------------------------

/// Resource sensitivity used by the policy engine's data-classification axis and shown on the
/// public Data Classification Explorer. PUBLIC: no account needed. PROTECTED: requires a
/// signed-in account and, for donor-scoped resources, ownership. SENSITIVE: medical/next-of-kin
/// detail - requires ownership (donor) or an administrator role; never shown to the public agent.
enum DataClassification {
  PUBLIC
  PROTECTED
  SENSITIVE
}

enum AccessDecision {
  ALLOW
  DENY
}

/// A reviewable, display-only copy of the access-control matrix enforced in
/// server/src/security/policies.ts. Seeded once from that same source of truth (see
/// prisma/seed.ts) so the public Policy Explorer and admin Security dashboard can list/query
/// policies without duplicating the enforcement code path into SQL. Never read by
/// policyEngine.ts itself when making a live decision.
model SecurityPolicy {
  id             String             @id @default(cuid())
  /// Stable slug matching the policy's id in policies.ts, e.g. "donor-own-profile-view".
  code           String             @unique
  /// "PUBLIC" | "DONOR" | "ADMIN" | "SUPER_ADMIN" - a plain string, not the Role enum, because
  /// PUBLIC (unauthenticated) is a valid actor in the access-control matrix but not a valid
  /// User.role value.
  role           String
  resource       String
  action         String
  classification DataClassification
  requiresOwnership Boolean         @map("requires_ownership")
  decision       AccessDecision
  description    String

  @@index([role, resource, action])
  @@map("security_policies")
}

/// One recorded access-control decision (RBAC + ownership + ABAC), written by
/// security/policyEngine.ts every time it evaluates a guarded operation - including the AI
/// gateway's tool-authorization checks. Metadata only: never stores medical data, credentials,
/// secrets, or a raw request body/prompt.
model SecurityEvent {
  id             String             @id @default(cuid())
  /// Null for an unauthenticated (PUBLIC) actor.
  actorUserId    String?            @map("actor_user_id")
  actorRole      String             @map("actor_role")
  resource       String
  action         String
  classification DataClassification
  decision       AccessDecision
  /// Which named policy produced this decision (SecurityPolicy.code), for traceability.
  policyCode     String             @map("policy_code")
  reason         String
  /// Resource instance id when the check was ownership-scoped (e.g. a donorId), never a full record.
  resourceId     String?            @map("resource_id")
  ipAddress      String?            @map("ip_address")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([decision, createdAt])
  @@index([actorRole, createdAt])
  @@index([resource, action])
  @@index([createdAt])
  @@map("security_events")
}

enum AiRequestClassification {
  ORGANFLOW_RELEVANT
  OUT_OF_SCOPE
  PRIVATE_DATA_REQUEST
  CREDENTIAL_REQUEST
  SECURITY_ABUSE
  INAPPROPRIATE_CONTENT
  AUTHORIZED_SECURITY_ANALYSIS
}

/// One AI Security Gateway decision - recorded for every investigation request (admin or
/// public) BEFORE any LangGraph/LLM/provider call is made for ALLOW, and INSTEAD OF one for
/// BLOCK. Never stores the raw prompt text beyond a short, truncated excerpt (for operator
/// troubleshooting only) and never stores a provider response.
model AiSecurityEvent {
  id             String                   @id @default(cuid())
  actorUserId    String?                  @map("actor_user_id")
  actorRole      String                   @map("actor_role")
  /// "admin" or "public" - which investigation entry point this request came through.
  surface        String
  classification AiRequestClassification
  decision       AccessDecision
  reason         String
  /// First 160 chars of the question, for operator troubleshooting only - never the full prompt,
  /// never logged anywhere else, never shown to any end user other than an admin on /admin/security.
  questionExcerpt String?                 @map("question_excerpt")
  toolsAuthorized String[]                @map("tools_authorized")
  createdAt      DateTime                 @default(now()) @map("created_at")

  @@index([decision, createdAt])
  @@index([classification, createdAt])
  @@index([createdAt])
  @@map("ai_security_events")
}

/// Real server-side session record, one per signed-in device/browser. The JWT's `jti` claim is
/// this row's id (see server/src/utils/jwt.ts) - requireAuth looks the session up on every
/// request and rejects a revoked or expired one immediately, even if the JWT itself has not
/// expired yet. This is what makes "Sign out of this device" and "Sign out of all other
/// sessions" actually work, rather than only clearing a cookie the old token could still replay.
/// Never stores the raw JWT/cookie value - only a SHA-256 hash of it, so a leaked database row
/// can never be replayed as a session token on its own.
model UserSession {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  /// SHA-256 hex digest of the signed JWT this session issued. Looked up on each request instead
  /// of storing the token itself.
  tokenHash      String    @unique @map("token_hash")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastUsedAt     DateTime  @default(now()) @map("last_used_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  /// Coarse, privacy-safe device metadata parsed from the User-Agent header at login time - never
  /// a fingerprinting payload, never raw headers.
  browser        String?
  os             String?
  /// Optional, coarse and privacy-safe: never a precise location, never stored as a claim of
  /// geography - see services/session.service.ts for what little is derived from it, if anything.
  ipHash         String?   @map("ip_hash")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}
