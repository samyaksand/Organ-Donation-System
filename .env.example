# Copy to `.env` at the repository root and fill in real values.
# `.env` is gitignored — never commit it.

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/organ_donation?schema=public"

# Long random secret (>= 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=c7-OOEDK8FLcmklzgIEP2VmeCdXFW5J5zdtKYrruimIkmX7Q_Q3VosfKAvPPYFUn
# Token / cookie lifetime, e.g. 15m, 8h, 7d
JWT_EXPIRES_IN=8h

# Browser origin allowed by CORS (comma-separate multiple origins)
CLIENT_ORIGIN=http://localhost:5173

# Set to true only when serving over HTTPS (forced on when NODE_ENV=production)
COOKIE_SECURE=false

# Auth rate limit: max attempts per window (window in minutes)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MIN=15

# --- Client (Vite) --------------------------------------------------------
# Leave empty in development: Vite proxies /api to the server.
# Set only when the API is hosted on a different origin.
VITE_API_BASE_URL=
